# ============================================================
# 꽃폈네 OS — 환경변수 템플릿 (v2026-11-20)
# 복사해서 .env.local 만들기 (.env.local은 Git 커밋 금지)
# Vercel에도 동일하게 등록 → Settings > Environment Variables
# ============================================================

# ── Supabase (대시보드 > Project Settings > API) ──────────────
# "Project URL" 복사
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# "Publishable API Key" 복사
# 대시보드에서 "Publishable API Key" 또는 "anon / public" 항목의 값
# 아래 두 이름 중 하나만 설정하면 됩니다 (코드가 둘 다 지원)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY_HERE
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE  ← 구 명칭 대안

# "Secret API Key" 복사 (서버 전용 — 절대 public 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# ── 관리자 설정 (서버 전용) ───────────────────────────────────
# Google 로그인 성공 여부와 무관하게, 이 목록에 없는 계정은 접근 거부됨
# 반드시 1개 이상 입력. 비워두면 모든 admin 경로가 차단됨
# 여러 계정은 쉼표로 구분: admin1@gmail.com,admin2@gmail.com
ADMIN_EMAILS=your-admin@gmail.com

# ── 앱 URL ───────────────────────────────────────────────────
# Vercel Production은 자동 설정됨 (VERCEL_URL)
NEXT_PUBLIC_SITE_URL=https://floweros-next.vercel.app
