# ============================================================
# 꽃폈네 OS — 환경변수 템플릿
# 이 파일을 복사해 .env.local을 만드세요 (Git 커밋 금지)
# Vercel 대시보드 > Settings > Environment Variables에도 동일하게 추가
# ============================================================

# Supabase — 대시보드 > Project Settings > API에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Supabase Service Role (서버 전용 — 절대 public 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# 관리자 이메일 (쉼표 구분, 서버 전용)
# 예: ADMIN_EMAILS=fm@farmblossom.kr,admin@farmblossom.kr
ADMIN_EMAILS=

# 앱 URL (Vercel에서 VERCEL_URL로 자동 설정됨)
NEXT_PUBLIC_SITE_URL=https://floweros-next.vercel.app
